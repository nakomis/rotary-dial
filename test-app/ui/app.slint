import { RotaryDial } from "../../rotary-dial/ui/rotary-dial.slint";

export component AppWindow inherits Window {
    title: "Rotary Dial — Test App";
    width: 400px;
    height: 460px;
    background: #1a1a2e;

    in-out property <float> setpoint <=> dial.setpoint;
    callback setpoint-changed(float);

    changed setpoint => {
        root.setpoint-changed(root.setpoint);
    }

    VerticalLayout {
        alignment: center;
        padding: 20px;
        spacing: 16px;

        dial := RotaryDial {
            width: 320px;
            height: 320px;
            current-temperature: 18.5;
            setpoint: 21.0;
            min-temperature: 5.0;
            max-temperature: 30.0;
        }

        Text {
            text: "Drag the white handle to set temperature";
            color: #888899;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
